{
    "manifest_version": 1,
    "recipes": [
        {
            "recipe_id": "docs-only",
            "title": "Docs-only contributor checks",
            "path_globs": [
                "README.md",
                "docs/*.md",
                "docs/**/*.md"
            ],
            "commands": [
                "uv run pytest tests/unit/test_release_candidate_docs.py -q"
            ],
            "notes": "Use when documentation changes do not touch release gates, package metadata, generated API contracts, or runtime behavior."
        },
        {
            "recipe_id": "release-docs",
            "title": "Release document checks",
            "path_globs": [
                "docs/v*-release-gate.md",
                "docs/v*-release-candidate.md",
                "docs/release-packaging.md",
                "docs/version-release-policy.md"
            ],
            "commands": [
                "uv run glassbox eval run --profile release-candidate --cwd .",
                "uv run python scripts/validate_package_contents.py"
            ],
            "profile_ids": ["release-candidate"],
            "notes": "Pair deterministic release-candidate replay proof with packaging checks when release narrative or package-content policy changes."
        },
        {
            "recipe_id": "release-gate-scripts",
            "title": "Release gate script checks",
            "path_globs": [
                "scripts/validate_v*_release_gate.py",
                "scripts/validate_package_contents.py",
                "scripts/validate_installed_wheel_smoke.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_v11_release_gate.py tests/unit/test_packaging_metadata.py -q",
                "uv run python scripts/validate_v11_release_gate.py --dry-run"
            ],
            "profile_ids": ["release-candidate"],
            "notes": "Run the active v11 gate dry-run for release-gate script changes; historical versioned gates remain available for release-candidate sign-off."
        },
        {
            "recipe_id": "frontend-dashboard",
            "title": "Frontend dashboard checks",
            "path_globs": [
                "frontend/**/*.ts",
                "frontend/**/*.tsx",
                "frontend/**/*.mjs",
                "frontend/**/*.json",
                "src/glassbox/web/**/*.py"
            ],
            "commands": [
                "pnpm --dir frontend lint",
                "pnpm --dir frontend typecheck",
                "pnpm --dir frontend test",
                "pnpm --dir frontend build"
            ],
            "case_ids": [
                "dashboard.action-approval",
                "dashboard.action-answer",
                "long-run.cockpit-summary"
            ],
            "notes": "Add focused backend route tests when the touched path is under src/glassbox/web."
        },
        {
            "recipe_id": "changeset-runtime",
            "title": "Changeset runtime checks",
            "path_globs": [
                "src/glassbox/runtime/changeset*.py",
                "src/glassbox/runtime/change_inventory.py",
                "src/glassbox/runtime/commit_messages.py",
                "src/glassbox/runtime/commit_readiness.py",
                "src/glassbox/runtime/precommit_evidence.py",
                "src/glassbox/runtime/review_briefs.py",
                "tests/unit/test_changeset*.py",
                "tests/unit/test_change_inventory.py",
                "tests/unit/test_commit_messages.py",
                "tests/unit/test_commit_readiness.py",
                "tests/unit/test_precommit_evidence.py",
                "tests/unit/test_review_briefs.py",
                "tests/integration/test_changeset*.py",
                "tests/integration/test_change_inventory_provenance.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_changeset_derivation.py tests/unit/test_change_inventory.py tests/unit/test_changeset_verification_readiness.py tests/unit/test_review_briefs.py tests/unit/test_commit_readiness.py tests/integration/test_cli_changeset_commands.py tests/integration/test_web_changeset_routes.py -q",
                "uv run glassbox eval run changeset.reviewable-lifecycle --cwd ."
            ],
            "case_ids": ["changeset.reviewable-lifecycle"],
            "profile_ids": ["release-candidate"],
            "notes": "Use for local changeset lifecycle internals, inventory provenance, readiness, review briefs, and commit-prep posture. Replay evidence is lifecycle-level; focused tests remain the source for exact path and CLI/API behavior."
        },
        {
            "recipe_id": "review-loop-evidence",
            "title": "Review-loop feedback and evidence checks",
            "path_globs": [
                "src/glassbox/runtime/review_responses.py",
                "src/glassbox/runtime/manual_evidence.py",
                "src/glassbox/runtime/browser_evidence.py",
                "src/glassbox/runtime/accessibility_evidence.py",
                "src/glassbox/store/*review_loop*.py",
                "src/glassbox/store/repository_review_loop.py",
                "tests/unit/test_review_responses.py",
                "tests/unit/test_manual_evidence.py",
                "tests/unit/test_browser_evidence.py",
                "tests/unit/test_accessibility_evidence.py",
                "tests/integration/test_review_loop_projection.py",
                "tests/integration/test_review_response_fixup_inventory.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_review_responses.py tests/unit/test_manual_evidence.py tests/unit/test_browser_evidence.py tests/unit/test_accessibility_evidence.py tests/integration/test_review_loop_projection.py tests/integration/test_review_response_fixup_inventory.py -q"
            ],
            "case_ids": ["changeset.reviewable-lifecycle"],
            "notes": "Use for local review feedback, response fixups, manual evidence, browser evidence, accessibility notes, redaction, and projection behavior. These are advisory review-loop checks until v13 deterministic replay fixtures are added."
        },
        {
            "recipe_id": "changeset-surfaces",
            "title": "Changeset CLI, API, dashboard, and generated type checks",
            "path_globs": [
                "src/glassbox/cli/changeset_commands.py",
                "src/glassbox/cli/parser_changesets.py",
                "src/glassbox/web/changeset_api.py",
                "src/glassbox/web/routes/changesets.py",
                "frontend/components/console/changeset-console.tsx",
                "frontend/stores/changeset-store.ts",
                "frontend/generated/api-types.ts",
                "frontend/generated/openapi.json",
                "frontend/tests/changeset-console.test.tsx",
                "frontend/tests/generated-api-types.test.ts",
                "tests/integration/test_cli_changeset_commands.py",
                "tests/integration/test_web_changeset_routes.py",
                "tests/integration/test_openapi_schema.py"
            ],
            "commands": [
                "uv run pytest tests/integration/test_cli_changeset_commands.py tests/integration/test_web_changeset_routes.py tests/integration/test_openapi_schema.py -q",
                "pnpm --dir frontend lint",
                "pnpm --dir frontend typecheck",
                "pnpm --dir frontend test -- tests/changeset-console.test.tsx tests/generated-api-types.test.ts",
                "pnpm --dir frontend build"
            ],
            "case_ids": [
                "changeset.reviewable-lifecycle",
                "dashboard.action-approval",
                "dashboard.action-answer"
            ],
            "profile_ids": ["release-candidate"],
            "notes": "Use when operator-visible review-loop surfaces or generated API contracts change. Keep browser and accessibility evidence advisory unless a later deterministic fixture promotes them."
        },
        {
            "recipe_id": "runtime-events",
            "title": "Runtime event contract checks",
            "path_globs": [
                "src/glassbox/core/events.py",
                "src/glassbox/runtime/*event*.py",
                "src/glassbox/runtime/turn_event_recorder.py",
                "tests/unit/test_core_events.py",
                "tests/integration/test_sqlite_event_store.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_core_events.py tests/unit/test_turn_event_recorder.py tests/integration/test_sqlite_event_store.py -q"
            ],
            "notes": "Event schema changes must preserve canonical event compatibility or document intentional drift."
        },
        {
            "recipe_id": "store-schema",
            "title": "SQLite store schema checks",
            "path_globs": [
                "src/glassbox/store/sqlite_schema*.py",
                "src/glassbox/store/sqlite_projection*.py",
                "src/glassbox/store/sqlite_query*.py",
                "tests/unit/test_sqlite_*",
                "tests/integration/test_sqlite_*.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_sqlite_schema_boundaries.py tests/unit/test_sqlite_query_boundaries.py tests/integration/test_sqlite_bootstrap.py tests/integration/test_projection_rebuild.py -q"
            ],
            "notes": "Schema and projection work should keep canonical events authoritative and projections rebuildable."
        },
        {
            "recipe_id": "provider-posture",
            "title": "Provider posture checks",
            "path_globs": [
                "src/glassbox/runtime/provider*.py",
                "src/glassbox/cli/provider_commands.py",
                "docs/providers.md",
                "tests/unit/test_runtime_provider_config.py",
                "tests/unit/test_provider_recovery.py",
                "tests/integration/test_provider_mode_runtime.py"
            ],
            "commands": [
                "uv run pytest tests/unit/test_runtime_provider_config.py tests/unit/test_provider_recovery.py tests/integration/test_provider_mode_runtime.py -q"
            ],
            "notes": "Live-provider canaries remain advisory and require explicit operator selection."
        },
        {
            "recipe_id": "workspace-topology",
            "title": "Workspace topology checks",
            "path_globs": [
                "src/glassbox/runtime/workspace_topology.py",
                "tests/unit/test_workspace_topology.py",
                "docs/workspace-topology.md"
            ],
            "commands": [
                "uv run pytest tests/unit/test_workspace_topology.py tests/unit/test_eval_recommendations.py -q",
                "uv run glassbox repo topology build --cwd . --json"
            ],
            "case_ids": ["repository-index.context-drift"],
            "notes": "Topology changes should prove the builder and the topology-aware recommendation layer; the build command only refreshes local .glassbox topology evidence."
        },
        {
            "recipe_id": "packaging",
            "title": "Packaging and installed smoke checks",
            "path_globs": [
                "pyproject.toml",
                "uv.lock",
                "scripts/validate_package_contents.py",
                "scripts/validate_installed_wheel_smoke.py",
                "tests/unit/test_packaging_metadata.py",
                "tests/unit/test_installed_wheel_smoke.py",
                "docs/release-packaging.md"
            ],
            "commands": [
                "uv run pytest tests/unit/test_packaging_metadata.py tests/unit/test_installed_wheel_smoke.py -q",
                "uv run python scripts/validate_package_contents.py"
            ],
            "notes": "Use alongside an installed-wheel smoke when package metadata or package contents change."
        }
    ]
}
