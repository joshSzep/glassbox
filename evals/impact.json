{
    "manifest_version": 1,
    "rules": [
        {
            "rule_id": "runtime-replay",
            "title": "Replay and eval runtime core",
            "path_globs": [
                "src/glassbox/runtime/replay*.py",
                "src/glassbox/runtime/eval*.py",
                "src/glassbox/cli/replay_eval_*.py"
            ],
            "owners": ["runtime.replay"],
            "capabilities": [
                "smoke_validation",
                "replay_portability",
                "cancellation"
            ]
        },
        {
            "rule_id": "runtime-cancellation",
            "title": "Cancellation runtime surfaces",
            "path_globs": [
                "src/glassbox/runtime/cancellation.py",
                "src/glassbox/runtime/turn_engine.py",
                "src/glassbox/runtime/turn_event_recorder.py",
                "src/glassbox/runtime/turn_tool_executor.py",
                "src/glassbox/runtime/model_loop.py",
                "src/glassbox/tools/_subprocess.py",
                "src/glassbox/web/routes/sessions.py",
                "src/glassbox/cli/*interactive*.py"
            ],
            "owners": ["runtime.cancellation"],
            "capabilities": ["cancellation"],
            "case_ids": [
                "cancellation.cancelled-turn",
                "cancellation.model-call",
                "cancellation.tool-execution",
                "cancellation.repeated-request"
            ],
            "notes": "Cancellation runtime changes should run the multi-case advisory cancellation set plus focused unit and integration coverage for model calls, local tool cancellation, and subprocess classification."
        },
        {
            "rule_id": "runtime-context",
            "title": "Runtime context derivation",
            "path_globs": [
                "src/glassbox/runtime/context*.py",
                "src/glassbox/runtime/runtime_context_derivation.py",
                "tests/unit/test_context_builder.py",
                "tests/integration/test_session_query_characterization.py",
                "docs/runtime-context.md"
            ],
            "owners": ["runtime.context"],
            "capabilities": [
                "context_inheritance",
                "context_drift_detection",
                "artifact_backed_context",
                "selected_invariant_contract"
            ],
            "notes": "Runtime context changes should review inherited notes, working-set budgets, artifact-backed summaries, and selected-invariant replay drift."
        },
        {
            "rule_id": "runtime-branching",
            "title": "Branching and lineage workflows",
            "path_globs": [
                "src/glassbox/runtime/*fork*.py",
                "src/glassbox/cli/*fork*.py",
                "docs/branching.md"
            ],
            "owners": ["runtime.context"],
            "capabilities": ["branching", "context_inheritance"]
        },
        {
            "rule_id": "runtime-approval-flow",
            "title": "Approval workflow surfaces",
            "path_globs": [
                "src/glassbox/runtime/*approval*.py",
                "src/glassbox/cli/*approval*.py",
                "src/glassbox/web/*approval*.py",
                "src/glassbox/web/routes/approvals.py",
                "frontend/**/*approval*.ts",
                "frontend/**/*approval*.tsx"
            ],
            "owners": ["runtime.approval"],
            "capabilities": ["approval_flow"],
            "case_ids": ["approval.approved-patch"],
            "notes": "Approval-related runtime, CLI, web, or dashboard action changes should re-run the curated approval replay case plus focused integration tests for denial and UI-specific resolution behavior."
        },
        {
            "rule_id": "tool-policy-governance",
            "title": "Repository tool-policy governance",
            "path_globs": [
                "glassbox-policy.json",
                "**/glassbox-policy.json",
                "src/glassbox/tools/policy.py",
                "src/glassbox/tools/policy_config.py",
                "tests/unit/test_tools_policy.py",
                "docs/tool-policy.md",
                "docs/examples/tool-policy/*.json"
            ],
            "owners": ["runtime.approval"],
            "capabilities": ["approval_flow"],
            "case_ids": ["approval.approved-patch"],
            "notes": "Tool-policy manifest or engine changes should re-run the curated approval replay case and focused policy unit tests that cover repository rules, defaults, denies, invariant blocks, and path/cwd/command selectors."
        },
        {
            "rule_id": "runtime-ask-user",
            "title": "Ask-user workflow surfaces",
            "path_globs": [
                "src/glassbox/tools/ask_user.py",
                "src/glassbox/runtime/*question*.py",
                "src/glassbox/runtime/*ask*.py",
                "src/glassbox/cli/*answer*.py",
                "src/glassbox/web/routes/sessions.py",
                "frontend/**/*answer*.ts",
                "frontend/**/*answer*.tsx",
                "frontend/**/*question*.ts",
                "frontend/**/*question*.tsx"
            ],
            "owners": ["runtime.ask-user"],
            "capabilities": ["ask_user_flow"],
            "case_ids": ["ask-user.answer-resume"],
            "notes": "Ask-user, answer, question, or resumption changes should re-run the curated answer-resume replay case plus focused tests for validation and UI error handling."
        },
        {
            "rule_id": "dashboard-actions",
            "title": "Dashboard action surfaces",
            "path_globs": [
                "src/glassbox/web/routes/sessions.py",
                "src/glassbox/web/routes/approvals.py",
                "frontend/api/**/*.ts",
                "frontend/components/console/*.ts",
                "frontend/components/console/*.tsx",
                "frontend/components/console/**/*.ts",
                "frontend/components/console/**/*.tsx",
                "frontend/state/**/*.ts",
                "frontend/**/*action*.ts",
                "frontend/**/*action*.tsx",
                "frontend/**/*dashboard*.ts",
                "frontend/**/*dashboard*.tsx",
                "frontend/**/*store*.ts",
                "frontend/**/*store*.tsx"
            ],
            "owners": ["web.dashboard"],
            "capabilities": ["dashboard_actions"],
            "case_ids": [
                "dashboard.action-approval",
                "dashboard.action-answer"
            ],
            "notes": "Dashboard action changes should review the replay-representable canonical event cases and keep live route or optimistic UI behavior in focused web/frontend tests."
        },
        {
            "rule_id": "runtime-daemon-attach",
            "title": "Daemon attach and persisted-session access",
            "path_globs": [
                "src/glassbox/runtime/daemon*.py",
                "src/glassbox/cli/*daemon*.py",
                "src/glassbox/cli/*interactive*.py",
                "src/glassbox/web/routes/sessions.py",
                "docs/persistent-runtime.md"
            ],
            "owners": ["runtime.daemon"],
            "capabilities": ["daemon_attach"],
            "case_ids": ["daemon.attach-persisted-actions"],
            "notes": "Daemon attach changes should pair persisted-event replay evidence with focused daemon lifecycle tests for process health, port conflicts, and stale-owner recovery."
        },
        {
            "rule_id": "v8-task-and-autonomy-runtime",
            "title": "v8 task and autonomy runtime surfaces",
            "path_globs": [
                "src/glassbox/runtime/task*.py",
                "src/glassbox/runtime/autonomy.py",
                "src/glassbox/runtime/background_jobs.py",
                "src/glassbox/cli/task_commands.py",
                "src/glassbox/cli/*autonomy*.py",
                "src/glassbox/web/routes/tasks.py",
                "tests/integration/test_cli_task_commands.py",
                "tests/integration/test_background_job_runner.py",
                "tests/integration/test_web_task_routes.py",
                "docs/task-plans.md",
                "docs/background-jobs.md"
            ],
            "owners": ["runtime.tasks", "runtime.autonomy"],
            "capabilities": [
                "task_plan_proposal_capture",
                "task_continuation_until_blocked",
                "autonomy_budget_exhaustion"
            ],
            "case_ids": [
                "task-plan.proposal-capture",
                "task.continuation-blocked",
                "autonomy.budget-exhaustion"
            ],
            "profile_ids": ["v8-autonomy-advisory"],
            "notes": "Task-plan, autonomy-budget, or background-continuation changes should run the v8 autonomy advisory profile plus focused task, daemon-job, and budget tests before release evidence is accepted."
        },
        {
            "rule_id": "v8-memory-and-index-context",
            "title": "v8 memory and repository-index context surfaces",
            "path_globs": [
                "src/glassbox/runtime/workspace_memory*.py",
                "src/glassbox/runtime/repository_index.py",
                "src/glassbox/runtime/context*.py",
                "src/glassbox/cli/memory_commands.py",
                "src/glassbox/cli/repository_commands.py",
                "src/glassbox/web/routes/memory.py",
                "src/glassbox/web/routes/repository_index.py",
                "tests/unit/test_workspace_memory*.py",
                "tests/unit/test_repository_index.py",
                "tests/integration/test_cli_memory_commands.py",
                "tests/integration/test_cli_repository_commands.py",
                "docs/workspace-memory.md",
                "docs/repository-intelligence-index.md"
            ],
            "owners": ["runtime.memory", "runtime.repository-index"],
            "capabilities": [
                "memory_context_drift",
                "repository_index_context_drift"
            ],
            "case_ids": [
                "memory.context-drift",
                "repository-index.context-drift"
            ],
            "profile_ids": ["v8-autonomy-advisory"],
            "notes": "Workspace-memory and repository-index changes should pair the advisory replay context cases with focused freshness, provenance, invalidation, and rebuild tests."
        },
        {
            "rule_id": "v8-verification-and-branch-search",
            "title": "v8 verification loop and branch-search surfaces",
            "path_globs": [
                "src/glassbox/runtime/verification*.py",
                "src/glassbox/runtime/branch_search.py",
                "src/glassbox/cli/branch_search_commands.py",
                "tests/unit/test_verify_repair_loop.py",
                "tests/unit/test_branch_search.py",
                "docs/verification-loops.md",
                "docs/branch-search.md"
            ],
            "owners": ["runtime.verification", "runtime.branch-search"],
            "capabilities": [
                "verification_loop_success",
                "verification_loop_failure",
                "branch_search_candidate_comparison"
            ],
            "case_ids": [
                "verification.success",
                "verification.failure",
                "branch-search.candidate-comparison"
            ],
            "profile_ids": ["v8-autonomy-advisory"],
            "notes": "Verification-loop or branch-search changes should run the v8 autonomy advisory replay profile plus focused tests for command outcomes, repair budgets, candidate limits, and cleanup behavior."
        },
        {
            "rule_id": "v10-checkpoint-compaction-recovery",
            "title": "v10 checkpoint and compaction recovery surfaces",
            "path_globs": [
                "src/glassbox/runtime/checkpoints.py",
                "src/glassbox/runtime/context_compaction*.py",
                "src/glassbox/store/*checkpoint*.py",
                "src/glassbox/store/*compaction*.py",
                "src/glassbox/cli/compaction_commands.py",
                "docs/context-compactions.md",
                "docs/v10-long-running-task-contract.md"
            ],
            "owners": ["runtime.context", "runtime.tasks"],
            "capabilities": [
                "artifact_backed_context",
                "checkpoint_resume_recovery",
                "context_compaction_provenance",
                "context_drift_detection",
                "incomplete_turn_recovery",
                "stale_compaction_exclusion",
                "task_continuation_until_blocked"
            ],
            "case_ids": [
                "context.artifact",
                "context.branch-inherited",
                "context.compaction-provenance",
                "long-run.recovery-boundaries",
                "task.continuation-blocked"
            ],
            "profile_ids": [
                "commit-smoke",
                "release-candidate",
                "v8-autonomy-advisory"
            ],
            "notes": "Checkpoint or compaction changes should review immediate proof, checkpoint freshness, and pre-resume recovery posture before release-candidate validation."
        },
        {
            "rule_id": "v10-tool-attempt-recovery",
            "title": "v10 tool attempt retry and partial-output recovery",
            "path_globs": [
                "src/glassbox/runtime/tool_attempt*.py",
                "src/glassbox/store/*tool_attempt*.py",
                "src/glassbox/cli/tool_attempt_commands.py",
                "src/glassbox/tools/*.py",
                "docs/tool-attempts.md"
            ],
            "owners": ["runtime.cancellation", "runtime.verification"],
            "capabilities": [
                "cancellation",
                "tool_attempt_partial_output",
                "tool_attempt_safe_retry",
                "verification_loop_failure",
                "verification_loop_success"
            ],
            "case_ids": [
                "cancellation.tool-execution",
                "tool-attempt.partial-retry",
                "verification.failure",
                "verification.success"
            ],
            "profile_ids": ["release-candidate", "v8-autonomy-advisory"],
            "notes": "Tool-attempt recovery changes should verify partial-output evidence, safe retry classification, cancellation posture, and focused repair-loop behavior."
        },
        {
            "rule_id": "v10-long-run-cockpit",
            "title": "v10 long-run cockpit and task evidence dashboard",
            "path_globs": [
                "frontend/components/console/long-run-cockpit/**",
                "frontend/components/console/task-autonomy*.tsx",
                "frontend/components/console/workspace-overview/**",
                "frontend/stores/task-store.ts",
                "src/glassbox/runtime/task_queries.py",
                "src/glassbox/web/routes/tasks.py",
                "docs/long-run-cockpit-contract.md",
                "docs/dashboard-cockpit-contract.md"
            ],
            "owners": ["web.dashboard", "runtime.tasks"],
            "capabilities": [
                "dashboard_actions",
                "long_run_cockpit_summary",
                "stale_verification_warning",
                "task_plan_proposal_capture",
                "task_continuation_until_blocked"
            ],
            "case_ids": [
                "dashboard.action-approval",
                "dashboard.action-answer",
                "long-run.cockpit-summary",
                "task-plan.proposal-capture",
                "task.continuation-blocked",
                "verification.stale-cockpit"
            ],
            "profile_ids": ["release-candidate", "v8-autonomy-advisory"],
            "notes": "Long-run cockpit changes should pair dashboard component tests with replay-backed action, task-plan, and continuation evidence."
        },
        {
            "rule_id": "provider-readiness",
            "title": "Provider diagnostics and recommendation surfaces",
            "path_globs": [
                "src/glassbox/runtime/provider*.py",
                "src/glassbox/cli/provider_commands.py",
                "tests/unit/test_runtime_provider_config.py",
                "tests/integration/test_provider_mode_runtime.py",
                "docs/providers.md"
            ],
            "owners": ["runtime.provider"],
            "profile_ids": ["live-provider-canary"],
            "notes": "Provider diagnostics and recommendation changes should review deterministic tests first; live-provider canary evidence remains advisory and requires explicit operator selection."
        },
        {
            "rule_id": "eval-profile-governance",
            "title": "Eval profile governance metadata",
            "path_globs": ["evals/profiles.json"],
            "profile_ids": [
                "commit-smoke",
                "push-confirmation",
                "release-candidate",
                "advisory-context",
                "v7-workflow-advisory",
                "v8-autonomy-advisory"
            ]
        }
    ]
}
