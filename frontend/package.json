{
  "name": "glassbox-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev",
    "api:format": "prettier --write generated/openapi.json generated/api-types.ts",
    "api:generate": "pnpm run api:schema && pnpm run api:types && pnpm run api:format",
    "api:schema": "cd .. && uv run python -m glassbox.web.openapi_schema frontend/generated/openapi.json",
    "api:types": "openapi-typescript generated/openapi.json -o generated/api-types.ts",
    "build": "next build && pnpm run build:copy-static",
    "build:copy-static": "rm -rf ../src/glassbox/web/static_next && mkdir -p ../src/glassbox/web/static_next && cp -R out/. ../src/glassbox/web/static_next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.4.0",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.6",
    "prettier": "3.8.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
